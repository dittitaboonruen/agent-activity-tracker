# Jotform API key — server-side only.
# Never prefix this with NEXT_PUBLIC_. It must stay out of the browser bundle.
# Get it from Jotform: Account Settings → API → Create New Key.
JOTFORM_API_KEY=your_jotform_api_key_here

# The numeric form ID for "Agent Activity Tracker".
# Find it in the form's edit URL: https://www.jotform.com/build/<FORM_ID>
JOTFORM_FORM_ID=262221782679061
